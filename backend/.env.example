# Local development defaults - copy to .env and adjust as needed.
# Never commit a real .env file (rules.md Rule 17.3 - never expose secrets).

SPRING_PROFILES_ACTIVE=local

# Not used by the "local" profile: it generates a random secret on every start (set LOCAL_JWT_SECRET to keep
# sessions across restarts) and ignores this variable.
# Required for "production": at least 32 random bytes, e.g. `openssl rand -base64 48`. The application refuses to
# start with a short, repetitive or previously committed value, or with local/test active next to production (F-17).
JWT_SECRET=

# Only needed for the "test" and "production" profiles - local uses the
# hardcoded values in application-local.yml against docker-compose.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
REDIS_URL=

# Only needed for the "production" profile (Phase 2 OTP delivery via
# Brevo Transactional SMS). Not required for local/test - both use
# non-SMS OtpSender implementations instead.
BREVO_API_KEY=
BREVO_SMS_SENDER_NAME=FirstFood

# Only needed for "production" - local/test default to
# http://localhost:3000. Comma-separated if more than one origin (e.g. a
# staging frontend URL in addition to the production one).
CORS_ALLOWED_ORIGINS=

# Phase 10 background jobs. "true" (default) = this instance schedules the
# jobs (a lease in the database makes sure only one instance runs each one);
# "false" = this instance never starts them, e.g. a one-off task or a debug run.
JOBS_ENABLED=true

# F-05 (SMS pumping). Cloudflare Turnstile guards the PUBLIC OTP request.
# "production" turns it ON by default: it will not start without TURNSTILE_SECRET_KEY, which is deliberate (a missing
# key must not silently leave SMS open to abuse). Set BOT_CHALLENGE_ENABLED=false only on purpose. local/test default to off.
# The matching public SITE key is a FRONTEND build value: NEXT_PUBLIC_TURNSTILE_SITE_KEY (see frontend/deploy/README.md).
BOT_CHALLENGE_ENABLED=
TURNSTILE_SECRET_KEY=

# F-05: where OTP SMS may go and how many may be sent site-wide. Defaults are sized for the pilot (docs/OPERATIONS.md).
# Country calling codes, comma-separated, digits only. Also allow the country in the Brevo account before adding one.
SMS_ALLOWED_COUNTRY_CODES=91
SMS_HOURLY_BUDGET=60
SMS_DAILY_BUDGET=300
SMS_ALERT_PERCENT=70
