# Copy to frontend/deploy/.env on the server (chmod 600). Never commit.
POSTGRES_PASSWORD=        # openssl rand -hex 24
REDIS_PASSWORD=           # openssl rand -hex 32  (keep URL-safe)
JWT_SECRET=               # openssl rand -base64 48
BREVO_API_KEY=            # Brevo > SMTP & API > API keys
BREVO_SENDER_EMAIL=       # a sender verified in Brevo
TURNSTILE_SECRET_KEY=     # Cloudflare Turnstile secret (backend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  # Turnstile site key (frontend, build-time)
GOOGLE_CLIENT_ID=                # Google OAuth Web client id (public): backend check + frontend build arg. Empty = no Google button
# Phone (SMS) sign-in is OFF until you have an SMS provider + DLT registration. Leave empty = email sign-in only.
# Set to true (and rebuild the frontend) only once SMS works.
NEXT_PUBLIC_PHONE_OTP_ENABLED=
# false = customers may add a phone number without a code (launch). Set true when SMS/DLT is live, together with
# NEXT_PUBLIC_PHONE_OTP_ENABLED=true above, to make verification mandatory.
PHONE_VERIFICATION_REQUIRED=
